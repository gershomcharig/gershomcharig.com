<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | escape }} — {{ site.name }}</title>
  <meta name="description" content="{{ (description or site.description) | escape }}">
  <meta name="author" content="{{ site.name }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title | escape }} — {{ site.name }}">
  <meta property="og:description" content="{{ (description or site.description) | escape }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:image" content="{{ site.url }}/img/open-graph.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)">
  <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/notes.css">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Notes" href="/notes/feed.xml">
</head>
<body class="notes-page">
  <a class="skip-link" href="#main">Skip to content</a>
  <header>
    <a href="/" aria-label="Gershom Charig home"><img src="/img/logomark.svg" alt="Gershom Charig"></a>
    <nav aria-label="Main navigation">
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
      <a href="/notes/" aria-current="page">Notes</a>
      <a href="/#contact">Contact</a>
    </nav>
  </header>
  <main id="main" class="notes-main">
    {{ content | safe }}
  </main>
  <footer class="notes-footer">
    <a href="/">{{ site.name }}</a>
    <a href="/notes/feed.xml">RSS ↗</a>
  </footer>
</body>
</html>
